      +reject(): void
      +cancel(): void
      +isConfirmed(): boolean
      +isRejected(): boolean
      +isCancelled(): boolean
      +getStatusName(): String
      +calculateDaysElapsed(): long
      +completeTutorial(tutorialId: TutorialId, learningPath: LearningPath): void
    }
  }

