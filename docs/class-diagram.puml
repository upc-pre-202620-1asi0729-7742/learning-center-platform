    class ProfileCreatedEvent <<domain event>> {
      +profileId: Long
      +email: String
    }
  }

  package "domain.repositories" {
    interface ProfileRepository <<repository>> {
      +findById(id: Long): Optional<Profile>
      +findByEmailAddress(email: EmailAddress): Optional<Profile>
      +existsByEmailAddress(email: EmailAddress): boolean
      +findAll(): List<Profile>
      +save(profile: Profile): Profile
    }
  }

  package "infrastructure.persistence.jpa.adapters" {
    class ProfileRepositoryImpl <<adapter>> {
      -profilePersistenceRepository: ProfilePersistenceRepository
      -domainEventPublisher: DomainEventPublisher
      +save(profile: Profile): Profile
    }
  }
}

' Shared Kernel

package "com.acme.center.platform.shared" {

  package "domain.model.aggregates" {
    abstract class AbstractDomainAggregateRoot<T> <<base aggregate>> {
      -domainEvents: List<Object>
      +registerDomainEvent(event: Object): void
      +domainEvents(): List<Object>
      +clearDomainEvents(): void
    }
  }

  package "application.result" {
    interface Result<T, E> <<sealed utility>> {
      +isSuccess(): boolean
      +isFailure(): boolean
      +fold(successFn: Function, failureFn: Function): R
    }

    class Success<T, E> <<record>>
    class Failure<T, E> <<record>>

    class ApplicationError <<value object>> {
      +code: String
      +message: String
      +details: String
      +{static} notFound(entity: String, key: String): ApplicationError
      +{static} conflict(entity: String, message: String): ApplicationError
      +{static} validationError(field: String, message: String): ApplicationError
      +{static} unexpected(context: String, message: String): ApplicationError
    }
  }

  package "infrastructure.events" {
    class DomainEventPublisher <<component>> {
      -applicationEventPublisher: ApplicationEventPublisher
      +publishAndClearEvents(aggregate: AbstractDomainAggregateRoot<?>): void
    }
  }

  package "infrastructure.concurrency.loom.configuration" {
    class VirtualThreadsConfiguration <<configuration>> {
      +applicationTaskExecutor(): TaskExecutor
    }
  }

  package "interfaces.rest" {
    class GlobalExceptionHandler <<exception handler>> {
      +handleMethodArgumentNotValid(ex: MethodArgumentNotValidException): ResponseEntity<ProblemDetail>
      +handleIllegalArgumentException(ex: IllegalArgumentException): ResponseEntity<ProblemDetail>
      +handleRuntimeException(ex: RuntimeException): ResponseEntity<ProblemDetail>
      +handleException(ex: Exception): ResponseEntity<ProblemDetail>
    }
  }

  package "interfaces.rest.transform" {
    class ProblemDetailFromApplicationErrorAssembler <<assembler>> {
      +{static} toProblemDetailFromApplicationError(error: ApplicationError): ProblemDetail
      +{static} toResponseFromApplicationError(error: ApplicationError): ResponseEntity<ProblemDetail>
      +{static} toStatusFromErrorCode(errorCode: String): HttpStatusCode
    }

    class ResponseEntityAssembler <<assembler>> {
      +{static} toResponseEntityFromResult(result: Result, successAssembler: Function, successStatus: HttpStatusCode): ResponseEntity<?>
    }
  }
}

