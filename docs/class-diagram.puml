      +ProgressRecordItem(enrollment: Enrollment, tutorialId: TutorialId)
      +{static} reconstitute(id: Long, enrollment: Enrollment, tutorialId: TutorialId, status: ProgressStatus, startedAt: Date, completedAt: Date): ProgressRecordItem
      +start(): void
      +complete(): void
      +isCompleted(): boolean
      +isInProgress(): boolean
      +isNotStarted(): boolean
      +calculateDaysElapsed(): long
