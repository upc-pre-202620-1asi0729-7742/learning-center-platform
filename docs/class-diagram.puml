      -acmeStudentRecordId: AcmeStudentRecordId
      -courseId: CourseId
      -progressRecord: ProgressRecord
      -status: EnrollmentStatus
      +Enrollment(studentRecordId: AcmeStudentRecordId, courseId: CourseId)
      +{static} reconstitute(id: Long, studentRecordId: AcmeStudentRecordId, courseId: CourseId, status: EnrollmentStatus, progressRecord: ProgressRecord): Enrollment
