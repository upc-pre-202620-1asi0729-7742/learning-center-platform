' Diagram Legend

legend right
  |= Stereotype |= Classification |= Layer |
  |<back:#E3F2FD> <<aggregate>> </back> | Aggregate Root (Encapsulated) | Domain Layer |
  |<back:#E8F5E9> <<entity>> </back> | Domain Entity | Domain Layer |
  |<back:#FFF3E0> <<value object>> </back> | Tactical Value Object | Domain Layer |
  |<back:#FFF8E1> <<record>> </back> | Immutable Java Record | Domain / Interfaces |
  |<back:#F3E5F5> <<service>> </back> | Command / Query Service (CQRS) | Application Layer |
  |<back:#FCE4EC> <<repository>> </back> | Domain Repository Port | Domain Layer |
  |<back:#ECEFF1> <<adapter>> </back> | Infrastructure Adapter (JPA/Loom/Security) | Infrastructure Layer |
  |<back:#FFFDE7> <<controller>> </back> | REST Controller (Endpoints) | Interfaces Layer |
  |<back:#E0F7FA> <<facade>> </back> | Anti-Corruption Layer (ACL) | Interfaces / Application |
  |<back:#F1F8E9> <<event handler>> </back> | Application Event Handler | Application Layer |
endlegend


' IAM (Identity & Access Management) Bounded Context

package "com.acme.center.platform.iam" {

  package "interfaces.rest" {
    class TokensController <<controller>> {
      -userCommandService: UserCommandService
      +generateToken(signInResource: SignInResource): ResponseEntity<?>
    }

    class UsersController <<controller>> {
      -userQueryService: UserQueryService
      -userCommandService: UserCommandService
      +createUser(signUpResource: SignUpResource): ResponseEntity<?>
      +getAllUsers(): ResponseEntity<List<UserResource>>
      +getUserById(userId: Long): ResponseEntity<UserResource>
    }

    class RolesController <<controller>> {
      -roleQueryService: RoleQueryService
      +getAllRoles(): ResponseEntity<List<RoleResource>>
    }
  }

  package "interfaces.acl" {
    class IamContextFacade <<facade>> {
      -userCommandService: UserCommandService
      -userQueryService: UserQueryService
      +createUser(username: String, password: String): Long
      +createUser(username: String, password: String, roleNames: List<String>): Long
      +fetchUserIdByUsername(username: String): Long
      +fetchUsernameByUserId(userId: Long): String
    }
  }

  package "application.commandservices" {
    interface UserCommandService <<service>> {
      +handle(command: SignInCommand): Result<ImmutablePair<User,String>, ApplicationError>
      +handle(command: SignUpCommand): Result<User, ApplicationError>
    }

    interface RoleCommandService <<service>> {
      +handle(command: SeedRolesCommand): void
    }
  }

  package "application.queryservices" {
    interface UserQueryService <<service>> {
      +handle(query: GetAllUsersQuery): List<User>
      +handle(query: GetUserByIdQuery): Optional<User>
      +handle(query: GetUserByUsernameQuery): Optional<User>
    }

    interface RoleQueryService <<service>> {
      +handle(query: GetAllRolesQuery): List<Role>
      +handle(query: GetRoleByNameQuery): Optional<Role>
    }
  }

  package "application.internal.commandservices" {
    class UserCommandServiceImpl <<service>> {
      -userRepository: UserRepository
      -hashingService: HashingService
      -tokenService: TokenService
      -roleRepository: RoleRepository
      +handle(command: SignInCommand): Result<ImmutablePair<User,String>, ApplicationError>
      +handle(command: SignUpCommand): Result<User, ApplicationError>
    }

    class RoleCommandServiceImpl <<service>> {
      -roleRepository: RoleRepository
      +handle(command: SeedRolesCommand): void
    }
  }

  package "application.internal.queryservices" {
    class UserQueryServiceImpl <<service>> {
      -userRepository: UserRepository
      +handle(query: GetAllUsersQuery): List<User>
      +handle(query: GetUserByIdQuery): Optional<User>
      +handle(query: GetUserByUsernameQuery): Optional<User>
    }

    class RoleQueryServiceImpl <<service>> {
      -roleRepository: RoleRepository
      +handle(query: GetAllRolesQuery): List<Role>
      +handle(query: GetRoleByNameQuery): Optional<Role>
    }
  }

  package "application.internal.eventhandlers" {
    class ApplicationReadyEventHandler <<event handler>> {
      -roleCommandService: RoleCommandService
      +on(event: ApplicationReadyEvent): void
    }
  }

  package "application.internal.outboundservices.hashing" {
    interface HashingService <<port>> {
      +encode(rawPassword: CharSequence): String
      +matches(rawPassword: CharSequence, encodedPassword: String): boolean
    }
  }

  package "application.internal.outboundservices.tokens" {
    interface TokenService <<port>> {
      +generateToken(username: String): String
      +getUsernameFromToken(token: String): String
      +validateToken(token: String): boolean
    }
  }

  package "domain.model.aggregates" {
    class User <<aggregate>> {
      -id: Long
      -username: String
      -password: String
      -roles: Set<Role>
      +User(username: String, password: String)
      +User(username: String, password: String, roles: List<Role>)
      +{static} reconstitute(id: Long, username: String, password: String, roles: Set<Role>): User
      +addRole(role: Role): User
      +addRoles(roles: List<Role>): User
    }
  }

  package "domain.model.entities" {
    class Role <<entity>> {
      -id: Long
      -name: Roles
      +Role(name: Roles)
      +{static} reconstitute(id: Long, name: Roles): Role
      +getStringName(): String
      +{static} getDefaultRole(): Role
      +{static} toRoleFromName(name: String): Role
      +{static} validateRoleSet(roles: List<Role>): List<Role>
    }
  }

  package "domain.model.valueobjects" {
    enum Roles <<enum>> {
      ROLE_USER
      ROLE_INSTRUCTOR
      ROLE_ADMIN
    }
  }

  package "domain.repositories" {
    interface UserRepository <<repository>> {
      +findById(id: Long): Optional<User>
      +findByUsername(username: String): Optional<User>
      +existsByUsername(username: String): boolean
      +findAll(): List<User>
      +save(user: User): User
    }

    interface RoleRepository <<repository>> {
      +findByName(name: Roles): Optional<Role>
      +existsByName(name: Roles): boolean
      +findAll(): List<Role>
      +save(role: Role): Role
    }
  }

  package "infrastructure.hashing.bcrypt.services" {
    class HashingServiceImpl <<adapter>> {
      -passwordEncoder: BCryptPasswordEncoder
      +encode(rawPassword: CharSequence): String
      +matches(rawPassword: CharSequence, encodedPassword: String): boolean
    }
  }

  package "infrastructure.tokens.jwt.services" {
    class TokenServiceImpl <<adapter>> {
      -secret: String
      -expirationDays: int
      +generateToken(authentication: Authentication): String
      +generateToken(username: String): String
      +getUsernameFromToken(token: String): String
      +validateToken(token: String): boolean
      +getBearerTokenFrom(request: HttpServletRequest): String
    }
  }

  package "infrastructure.persistence.jpa.adapters" {
    class UserRepositoryImpl <<adapter>> {
      -userPersistenceRepository: UserPersistenceRepository
      -domainEventPublisher: DomainEventPublisher
      +save(user: User): User
    }

    class RoleRepositoryImpl <<adapter>> {
      -rolePersistenceRepository: RolePersistenceRepository
      +save(role: Role): Role
    }
  }
}

